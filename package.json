{
  "name": "youtube-watch-later-cleaner",
  "description": "Safely remove videos from your YouTube Watch Later playlist.",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "build:chrome": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.315",
    "typescript": "^5.9.3",
    "wxt": "^0.20.26"
  }
}
